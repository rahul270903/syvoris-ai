# ==============================================================================
# SYVORIS Ai™ — Enterprise CRM Backend Configuration
# ==============================================================================

# Application Environment: 'development', 'staging', 'production'
ENVIRONMENT=development
APP_NAME="SYVORIS Ai™ Enterprise CRM"
DEBUG=true
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# Database Connectivity
# ------------------------------------------------------------------------------
# Standard PostgreSQL connection with Asyncpg:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/syvoris_crm

# Zero-dependency local developer fallback (AIOSQLite):
# DATABASE_URL=sqlite+aiosqlite:///./storage/syvoris_local.db

DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# Cryptographic Security & Authentication
# ------------------------------------------------------------------------------
# Generate a secure 32+ byte key for production: openssl rand -hex 32
SECRET_KEY=syvoris_enterprise_development_secret_key_change_in_production_32bytes!
JWT_ALGORITHM=HS256

# Session Lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# ------------------------------------------------------------------------------
# Email Service Adapter
# ------------------------------------------------------------------------------
# 'console' (local log file in storage/test_emails.log), 'smtp', or 'sendgrid'
EMAIL_BACKEND=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@syvoris.example
SMTP_PASSWORD=changeme
SMTP_TLS=true
EMAIL_FROM_ADDRESS=no-reply@syvoris.ai
EMAIL_FROM_NAME="SYVORIS Ai Security"

# ------------------------------------------------------------------------------
# Platform SuperAdmin Provisioning (First Boot)
# ------------------------------------------------------------------------------
PLATFORM_SUPERADMIN_EMAIL=superadmin@syvoris.ai
PLATFORM_SUPERADMIN_PASSWORD=SuperAdmin2026!
